# NextAuth session signing key. Generate a unique value for each environment.
AUTH_SECRET=

# Google OAuth client for Alphaville Workspace sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Set this in Vercel Production. Locally, NextAuth can infer the local URL.
# AUTH_URL=https://prod.alphaville.hk
ALPHAVILLE_WORKSPACE_DOMAIN=alphaville.hk

# Optional approved external accounts. Each passwordHash must be a bcrypt hash.
# Example shape: [{"email":"person@example.com","passwordHash":"$2a$..."}]
EXTERNAL_ACCOUNTS_JSON=[]

# Shared project records. Share the spreadsheet with the service account email.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
